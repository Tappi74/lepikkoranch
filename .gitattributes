# Git Attributes for LepikköRanch

# Auto detect text files and perform LF normalization
* text=auto

# Source code
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.md text eol=lf

# Config files
*.json text eol=lf
*.xml text eol=lf
*.txt text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Images
*.jpg binary
*.jpeg binary
*.png binary
*.gif binary
*.ico binary
*.webp binary
*.svg text

# Archives
*.zip binary
*.tar binary
*.gz binary

# Fonts
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.otf binary
